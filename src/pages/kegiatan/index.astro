---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getAllPhotosWithAlbumData, formatTanggalIndonesia } from '../../utils/kegiatan';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../data/site';

const albums = await getCollection('kegiatan');
const allPhotos = getAllPhotosWithAlbumData(albums);

// Kategori unik dari seluruh kegiatan
const categories = Array.from(
  new Set(albums.map((a) => a.data.category))
).sort();

// Tahun unik dari seluruh kegiatan
const years = Array.from(
  new Set(albums.map((a) => new Date(a.data.date).getFullYear().toString()))
).sort((a, b) => Number(b) - Number(a));

// Data JSON untuk Lightbox
const lightboxData = allPhotos.map((photo) => ({
  src: photo.image.src,
  title: photo.albumTitle,
  date: formatTanggalIndonesia(photo.albumDate),
  category: photo.albumCategory,
  albumUrl: `/kegiatan/${photo.slug}`,
}));
---

<BaseLayout
  title={`Galeri Dokumentasi Kegiatan — ${siteConfig.personal.name}`}
  description="Koleksi dokumentasi foto kegiatan lomba, pengabdian masyarakat, kepanitiaan organisasi, dan seminar kampus."
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Halaman Galeri -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <div class="flex items-center justify-center gap-2">
        <div class="h-[1px] w-8 bg-brand-accent/40"></div>
        <span class="text-xs font-sans tracking-[0.25em] font-semibold uppercase text-brand-accent">
          Arsip & Dokumentasi
        </span>
        <div class="h-[1px] w-8 bg-brand-accent/40"></div>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-medium tracking-tight text-brand-primary uppercase">
        Galeri Kegiatan Mahasiswa
      </h1>
      <p class="text-sm sm:text-base text-brand-muted font-sans leading-relaxed">
        Dokumentasi visual pengalaman di luar ruang kuliah: kompetisi hackathon, aksi sosial kemasyarakatan, serta dinamika organisasi kampus.
      </p>

      <!-- Ringkasan Statistik Album -->
      <div class="pt-2 flex items-center justify-center gap-6 text-xs text-brand-muted">
        <span><strong>{albums.length}</strong> Album Kegiatan</span>
        <span>•</span>
        <span><strong>{allPhotos.length}</strong> Total Foto Terdokumentasi</span>
      </div>
    </div>

    <!-- Filter Bar (Kategori & Tahun) -->
    <div class="mb-10 p-6 rounded-2xl bg-brand-surface border border-brand-border space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Filter Kategori -->
        <div class="space-y-2">
          <span class="text-[11px] font-sans font-semibold tracking-wider uppercase text-brand-muted block">
            Kategori Kegiatan:
          </span>
          <div class="flex flex-wrap gap-1.5" id="gallery-category-filters">
            <button
              type="button"
              class="cat-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-primary text-brand-bg transition-all"
              data-cat="all"
            >
              Semua ({allPhotos.length})
            </button>
            {categories.map((cat) => {
              const count = allPhotos.filter((p) => p.albumCategory === cat).length;
              return (
                <button
                  type="button"
                  class="cat-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-bg border border-brand-border text-brand-text hover:border-brand-primary hover:text-brand-primary transition-all"
                  data-cat={cat}
                >
                  {cat} ({count})
                </button>
              );
            })}
          </div>
        </div>

        <!-- Filter Tahun -->
        <div class="space-y-2 md:text-right">
          <span class="text-[11px] font-sans font-semibold tracking-wider uppercase text-brand-muted block">
            Tahun:
          </span>
          <div class="flex flex-wrap md:justify-end gap-1.5" id="gallery-year-filters">
            <button
              type="button"
              class="year-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-primary text-brand-bg transition-all"
              data-year="all"
            >
              Semua Tahun
            </button>
            {years.map((y) => (
              <button
                type="button"
                class="year-filter-btn px-3 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-bg border border-brand-border text-brand-text hover:border-brand-primary hover:text-brand-primary transition-all"
                data-year={y}
              >
                {y}
              </button>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Grid Masonry Responsif (1 col mobile, 2 tablet, 3-4 desktop) -->
    <div
      class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-5 space-y-5"
      id="masonry-gallery-container"
    >
      {allPhotos.map((photo, index) => {
        const yearStr = new Date(photo.albumDate).getFullYear().toString();

        return (
          <div
            class="gallery-card break-inside-avoid group relative rounded-2xl overflow-hidden bg-brand-surface border border-brand-border shadow-sm hover:shadow-xl transition-all duration-500 cursor-pointer"
            data-cat={photo.albumCategory}
            data-year={yearStr}
            data-lightbox-index={index}
            data-index={index}
          >
            <!-- Gambar Otomatis Teroptimasi via Astro Image -->
            <Image
              src={photo.image}
              alt={`${photo.albumTitle} - ${photo.filename}`}
              width={700}
              height={500}
              quality={85}
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              loading="lazy"
            />

            <!-- Dark Gradient Hover Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-primary/90 via-brand-primary/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-4">
              <!-- Top Info Pills -->
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-sans font-semibold tracking-wider uppercase bg-brand-bg/95 text-brand-primary shadow-sm">
                  {photo.albumCategory}
                </span>
                <span class="w-8 h-8 rounded-full bg-brand-bg/90 text-brand-primary flex items-center justify-center shadow-sm">
                  <Icon name="arrow-up-right" class="w-4 h-4" />
                </span>
              </div>

              <!-- Bottom Caption & Album Link -->
              <div class="space-y-1 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <span class="text-[11px] font-sans font-medium text-brand-bg/80 tracking-wider block">
                  {formatTanggalIndonesia(photo.albumDate)}
                </span>
                <h3 class="font-serif text-base font-medium text-brand-bg leading-tight">
                  {photo.albumTitle}
                </h3>
                <a
                  href={`/kegiatan/${photo.slug}`}
                  class="no-lightbox inline-flex items-center gap-1.5 text-[11px] font-sans font-semibold tracking-wider uppercase text-brand-accent-light hover:underline pt-1"
                >
                  <span>Buka Halaman Album</span>
                  <Icon name="arrow-right" class="w-3 h-3" />
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Tombol Muat Lebih Banyak (Load More) untuk Performa Tinggi -->
    <div class="mt-14 text-center" id="load-more-section">
      <button
        id="load-more-btn"
        type="button"
        class="hidden px-8 py-3.5 rounded-full bg-brand-primary text-brand-bg text-xs sm:text-sm font-semibold tracking-wider uppercase hover:bg-brand-primary-dark transition-all duration-300 shadow-md"
      >
        Muat Lebih Banyak Foto
      </button>
    </div>

    <!-- Pesan Kosong Jika Filter Tidak Ditemukan -->
    <div id="no-gallery-msg" class="hidden text-center py-20">
      <p class="font-serif text-2xl text-brand-muted">
        Tidak ada foto kegiatan yang sesuai dengan kategori ini.
      </p>
      <button
        id="reset-gallery-filter"
        type="button"
        class="mt-4 px-6 py-2.5 rounded-full bg-brand-primary text-brand-bg text-xs font-semibold tracking-wider uppercase"
      >
        Tampilkan Semua Foto
      </button>
    </div>

  </div>
</BaseLayout>

<script define:vars={{ lightboxData }}>
  // Registrasi data ke Lightbox
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof (window as any).registerLightboxGallery === 'function') {
      (window as any).registerLightboxGallery(lightboxData);
    }
  });

  // Client-side Filter & Pagination (Muat Lebih Banyak)
  let activeCat = 'all';
  let activeYear = 'all';
  const PAGE_SIZE = 12; // Tampilkan 12 per batch untuk performa cepat
  let visibleLimit = PAGE_SIZE;

  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
  const yearButtons = document.querySelectorAll<HTMLButtonElement>('.year-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.gallery-card');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const noGalleryMsg = document.getElementById('no-gallery-msg');
  const resetBtn = document.getElementById('reset-gallery-filter');

  function updateGalleryDisplay() {
    let matchCount = 0;
    let displayedCount = 0;

    cards.forEach((card) => {
      const cat = card.dataset.cat || '';
      const year = card.dataset.year || '';

      const matchCat = activeCat === 'all' || cat === activeCat;
      const matchYear = activeYear === 'all' || year === activeYear;

      if (matchCat && matchYear) {
        matchCount++;
        if (matchCount <= visibleLimit) {
          card.style.display = '';
          displayedCount++;
        } else {
          card.style.display = 'none';
        }
      } else {
        card.style.display = 'none';
      }
    });

    // Handle tombol Load More
    if (loadMoreBtn) {
      if (matchCount > displayedCount) {
        loadMoreBtn.classList.remove('hidden');
        loadMoreBtn.textContent = `Muat Lebih Banyak (${matchCount - displayedCount} Foto Tersisa)`;
      } else {
        loadMoreBtn.classList.add('hidden');
      }
    }

    // Handle pesan kosong
    if (noGalleryMsg) {
      if (matchCount === 0) {
        noGalleryMsg.classList.remove('hidden');
      } else {
        noGalleryMsg.classList.add('hidden');
      }
    }
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat || 'all';
      visibleLimit = PAGE_SIZE; // Reset limit saat ganti filter

      catButtons.forEach((b) => {
        b.classList.remove('bg-brand-primary', 'text-brand-bg');
        b.classList.add('bg-brand-bg', 'text-brand-text');
      });
      btn.classList.remove('bg-brand-bg', 'text-brand-text');
      btn.classList.add('bg-brand-primary', 'text-brand-bg');

      updateGalleryDisplay();
    });
  });

  yearButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeYear = btn.dataset.year || 'all';
      visibleLimit = PAGE_SIZE;

      yearButtons.forEach((b) => {
        b.classList.remove('bg-brand-primary', 'text-brand-bg');
        b.classList.add('bg-brand-bg', 'text-brand-text');
      });
      btn.classList.remove('bg-brand-bg', 'text-brand-text');
      btn.classList.add('bg-brand-primary', 'text-brand-bg');

      updateGalleryDisplay();
    });
  });

  loadMoreBtn?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    updateGalleryDisplay();
  });

  resetBtn?.addEventListener('click', () => {
    activeCat = 'all';
    activeYear = 'all';
    visibleLimit = PAGE_SIZE;

    catButtons.forEach((b) => {
      if (b.dataset.cat === 'all') {
        b.classList.add('bg-brand-primary', 'text-brand-bg');
        b.classList.remove('bg-brand-bg', 'text-brand-text');
      } else {
        b.classList.remove('bg-brand-primary', 'text-brand-bg');
        b.classList.add('bg-brand-bg', 'text-brand-text');
      }
    });

    yearButtons.forEach((b) => {
      if (b.dataset.year === 'all') {
        b.classList.add('bg-brand-primary', 'text-brand-bg');
        b.classList.remove('bg-brand-bg', 'text-brand-text');
      } else {
        b.classList.remove('bg-brand-primary', 'text-brand-bg');
        b.classList.add('bg-brand-bg', 'text-brand-text');
      }
    });

    updateGalleryDisplay();
  });

  // Jalankan inisialisasi awal
  updateGalleryDisplay();
</script>
