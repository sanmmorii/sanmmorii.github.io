---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import Icon from './Icon.astro';
import heroPortrait from '../assets/profile.jpeg';
---

<section data-hero class="relative pt-8 pb-16 md:pt-16 md:pb-24 overflow-hidden" aria-labelledby="hero-heading">
  <!-- Cahaya lembut yang mengikuti kursor -->
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- Bentuk dekoratif melayang di latar -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <span class="absolute top-[12%] left-[4%] w-3 h-3 rounded-full bg-brand-accent/30 anim-float" style="animation-delay:-1s"></span>
    <span class="absolute top-[58%] left-[44%] w-2 h-2 rounded-full bg-brand-primary/25 anim-float-slow" style="animation-delay:-2s"></span>
    <span class="absolute top-[20%] left-[48%] text-brand-accent/40 anim-twinkle" style="animation-delay:-0.6s">
      <Icon name="sparkle" class="w-5 h-5" />
    </span>
    <span class="absolute bottom-[10%] left-[8%] w-16 h-16 rounded-full border border-brand-accent/20 anim-float" style="animation-delay:-3s"></span>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Kolom Teks (Kiri) -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Sapaan Script Tipis -->
        <div class="hero-in flex items-center gap-2" style="--d:150ms">
          <span class="font-script text-3xl sm:text-4xl text-brand-accent tracking-wide transform -rotate-1 inline-block origin-left hover:rotate-2 hover:scale-105 transition-transform duration-500">
            {siteConfig.personal.hero.greeting}
          </span>
          <div class="h-[1px] w-12 bg-brand-accent/40" data-line style="--reveal-delay:700ms"></div>
        </div>

        <!-- Nama Besar Serif: muncul huruf per huruf -->
        <h1
          id="hero-heading"
          data-chars
          data-reveal-delay="300"
          class="font-serif text-5xl sm:text-7xl lg:text-8xl tracking-tight text-brand-primary font-medium uppercase leading-[0.95]"
        >
          {siteConfig.personal.name}
        </h1>

        <!-- Peran / Jurusan -->
        <div class="hero-in flex items-center gap-3" style="--d:900ms">
          <p class="font-sans text-xs sm:text-sm tracking-[0.25em] font-semibold uppercase text-brand-accent">
            {siteConfig.personal.role}
          </p>
          <span class="text-brand-border">•</span>
          <p class="font-sans text-xs sm:text-sm tracking-wider text-brand-muted">
            {siteConfig.personal.university}
          </p>
        </div>

        <!-- Deskripsi Singkat -->
        <p class="hero-in text-brand-text/90 text-base sm:text-lg leading-relaxed max-w-xl font-sans" style="--d:1050ms">
          {siteConfig.personal.hero.summary}
        </p>

        <!-- Tombol Aksi & Badge Status -->
        <div class="hero-in pt-4 flex flex-wrap items-center gap-4 sm:gap-6" style="--d:1200ms">
          <a
            href="#proyek"
            data-magnetic="0.25"
            class="btn-shine group inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-brand-primary text-brand-bg text-xs sm:text-sm font-semibold tracking-wider uppercase hover:bg-brand-primary-dark transition-colors duration-300 shadow-sm hover:shadow-lg"
          >
            <span>{siteConfig.personal.hero.ctaProject}</span>
            <span class="transform group-hover:translate-x-1.5 transition-transform duration-300">
              <Icon name="arrow-right" class="w-4 h-4" />
            </span>
          </a>

          <a
            href="#kontak"
            data-magnetic="0.2"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-brand-border bg-brand-surface/50 text-brand-text text-xs sm:text-sm font-semibold tracking-wider uppercase hover:bg-brand-surface hover:border-brand-primary/40 transition-colors"
          >
            <span>{siteConfig.personal.hero.ctaContact}</span>
          </a>
        </div>

        <!-- Info Domisili & Status -->
        <div class="hero-in pt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-brand-muted" style="--d:1350ms">
          <div class="flex items-center gap-2">
            <span class="relative flex w-2 h-2">
              <span class="absolute inset-0 rounded-full bg-emerald-600" style="animation: pulseRing 1.8s ease-out infinite"></span>
              <span class="relative w-2 h-2 rounded-full bg-emerald-600"></span>
            </span>
            <span>{siteConfig.personal.hero.statusText || "Terbuka untuk Peluang Magang & Kolaborasi"}</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-brand-accent" />
            <span>{siteConfig.personal.location}</span>
          </div>
        </div>
      </div>

      <!-- Kolom Foto di Frame Arch (Kanan) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
        <div class="relative w-full max-w-sm sm:max-w-md" data-depth="10">

          <!-- Outer Arch Border Frame: bernapas pelan -->
          <div class="absolute -inset-3 sm:-inset-4 border border-brand-accent/30 frame-arch pointer-events-none anim-arch-breath"></div>
          <div class="absolute -inset-6 sm:-inset-8 border border-brand-accent/15 frame-arch pointer-events-none anim-arch-breath" style="animation-delay:-2.5s"></div>

          <!-- Main Arch Photo Container: terbuka dari bawah ke atas -->
          <div data-reveal="arch" data-reveal-delay="250" class="relative frame-arch bg-brand-surface border border-brand-border shadow-xl aspect-[3/4] w-full overflow-hidden group">
            <Image
              src={heroPortrait}
              alt={`Foto potret ${siteConfig.personal.name}`}
              width={640}
              height={850}
              quality={90}
              class="hero-photo w-full h-full object-cover object-top transition-transform duration-[1200ms] ease-out group-hover:scale-105"
              loading="eager"
            />
            <!-- Gradient Overlay Bawah yang Halus -->
            <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-brand-primary/40 to-transparent pointer-events-none"></div>
          </div>

          <!-- Floating Circular Badge dengan Kutipan Singkat -->
          <div class="absolute -top-4 -right-4 sm:-top-6 sm:-right-6 z-10" data-depth="-18">
            <div class="hero-in" style="--d:1100ms; animation-name: popIn; animation-duration: 1s; animation-timing-function: var(--ease-spring)">
              <div class="anim-float w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-brand-bg/95 backdrop-blur-md border border-brand-border shadow-lg flex items-center justify-center p-2 relative">
                <!-- Teks Melingkar SVG Berputar Halus -->
                <svg class="w-full h-full animate-spin-slow" viewBox="0 0 100 100">
                  <path
                    id="badgeTextPath"
                    d="M 50, 50 m -36, 0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"
                    fill="none"
                  />
                  <text class="text-[7.5px] uppercase font-sans font-semibold tracking-[0.16em] fill-brand-primary">
                    <textPath href="#badgeTextPath" startOffset="0%">
                      {siteConfig.personal.hero.badgeQuote}
                    </textPath>
                  </text>
                </svg>
                <!-- Ikon Bintang di Tengah Badge -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <Icon name="star" class="w-4 h-4 text-brand-accent anim-twinkle" />
                </div>
              </div>
            </div>
          </div>

          <!-- Small Accent Decorative Star Beside Frame -->
          <div class="absolute -bottom-4 -left-4 sm:-bottom-6 sm:-left-6 z-10" data-depth="-24">
            <div class="hero-in" style="--d:1300ms; animation-name: popIn; animation-duration: 0.9s; animation-timing-function: var(--ease-spring)">
              <div class="anim-float-slow w-10 h-10 rounded-full bg-brand-surface border border-brand-border flex items-center justify-center shadow-md">
                <Icon name="sparkle" class="w-5 h-5 text-brand-accent anim-twinkle" />
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Petunjuk scroll -->
    <a
      href="#proyek"
      class="hero-in hidden lg:flex absolute left-1/2 -translate-x-1/2 -bottom-10 flex-col items-center gap-2 text-brand-muted hover:text-brand-accent transition-colors"
      style="--d:1700ms"
      aria-label="Gulir ke bawah"
    >
      <span class="text-[10px] tracking-[0.3em] uppercase font-semibold">Scroll</span>
      <span class="relative block w-[1.5px] h-10 bg-brand-border overflow-hidden rounded">
        <span class="absolute inset-x-0 top-0 h-4 bg-brand-accent rounded" style="animation: scrollCue 1.8s var(--ease-in-out) infinite"></span>
      </span>
    </a>
  </div>
</section>

<style is:global>
  @keyframes scrollCue {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(260%); }
  }
</style>
