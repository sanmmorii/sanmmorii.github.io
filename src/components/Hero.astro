---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import Icon from './Icon.astro';
import heroPortrait from '../assets/profile.jpeg';
---

<section class="relative pt-8 pb-16 md:pt-16 md:pb-24 overflow-hidden" aria-labelledby="hero-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Kolom Teks (Kiri) -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Sapaan Script Tipis -->
        <div class="flex items-center gap-2">
          <span class="font-script text-3xl sm:text-4xl text-brand-accent tracking-wide transform -rotate-1">
            {siteConfig.personal.hero.greeting}
          </span>
          <div class="h-[1px] w-12 bg-brand-accent/40"></div>
        </div>

        <!-- Nama Besar Serif (Gaya Editorial Elegan) -->
        <h1
          id="hero-heading"
          class="font-serif text-5xl sm:text-7xl lg:text-8xl tracking-tight text-brand-primary font-medium uppercase leading-[0.95]"
        >
          {siteConfig.personal.name}
        </h1>

        <!-- Peran / Jurusan -->
        <div class="flex items-center gap-3">
          <p class="font-sans text-xs sm:text-sm tracking-[0.25em] font-semibold uppercase text-brand-accent">
            {siteConfig.personal.role}
          </p>
          <span class="text-brand-border">•</span>
          <p class="font-sans text-xs sm:text-sm tracking-wider text-brand-muted">
            {siteConfig.personal.university}
          </p>
        </div>

        <!-- Deskripsi Singkat -->
        <p class="text-brand-text/90 text-base sm:text-lg leading-relaxed max-w-xl font-sans">
          {siteConfig.personal.hero.summary}
        </p>

        <!-- Tombol Aksi & Badge Status -->
        <div class="pt-4 flex flex-wrap items-center gap-4 sm:gap-6">
          <a
            href="#proyek"
            class="group inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-brand-primary text-brand-bg text-xs sm:text-sm font-semibold tracking-wider uppercase hover:bg-brand-primary-dark transition-all duration-300 shadow-sm hover:shadow-md"
          >
            <span>{siteConfig.personal.hero.ctaProject}</span>
            <span class="transform group-hover:translate-x-1 transition-transform">
              <Icon name="arrow-right" class="w-4 h-4" />
            </span>
          </a>

          <a
            href="#kontak"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-brand-border bg-brand-surface/50 text-brand-text text-xs sm:text-sm font-semibold tracking-wider uppercase hover:bg-brand-surface hover:border-brand-primary/40 transition-all"
          >
            <span>{siteConfig.personal.hero.ctaContact}</span>
          </a>
        </div>

        <!-- Info Domisili & Status -->
        <div class="pt-4 flex items-center gap-6 text-xs text-brand-muted">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            <span>{siteConfig.personal.hero.statusText || "Terbuka untuk Peluang Magang & Kolaborasi"}</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-brand-accent" />
            <span>{siteConfig.personal.location}</span>
          </div>
        </div>
      </div>

      <!-- Kolom Foto di Frame Arch (Kanan) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
        <div class="relative w-full max-w-sm sm:max-w-md">
          
          <!-- Outer Arch Border Frame (Garis Tipis Dekoratif Melengkung) -->
          <div class="absolute -inset-3 sm:-inset-4 border border-brand-accent/30 frame-arch pointer-events-none"></div>

          <!-- Main Arch Photo Container -->
          <div class="relative frame-arch bg-brand-surface border border-brand-border shadow-xl aspect-[3/4] w-full overflow-hidden group">
            <Image
              src={heroPortrait}
              alt={`Foto potret ${siteConfig.personal.name}`}
              width={640}
              height={850}
              quality={90}
              class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
            />
            <!-- Gradient Overlay Bawah yang Halus -->
            <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-brand-primary/40 to-transparent pointer-events-none"></div>
          </div>

          <!-- Floating Circular Badge dengan Kutipan Singkat (Sesuai Referensi Gambar) -->
          <div class="absolute -top-4 -right-4 sm:-top-6 sm:-right-6 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-brand-bg/95 backdrop-blur-md border border-brand-border shadow-lg flex items-center justify-center p-2 z-10">
            <!-- Teks Melingkar SVG Berputar Halus -->
            <svg class="w-full h-full animate-spin-slow" viewBox="0 0 100 100">
              <path
                id="badgeTextPath"
                d="M 50, 50 m -36, 0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"
                fill="none"
              />
              <text class="text-[7.5px] uppercase font-sans font-semibold tracking-[0.16em] fill-brand-primary">
                <textPath href="#badgeTextPath" startOffset="0%">
                  {siteConfig.personal.hero.badgeQuote}
                </textPath>
              </text>
            </svg>
            <!-- Ikon Bintang di Tengah Badge -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <Icon name="star" class="w-4 h-4 text-brand-accent" />
            </div>
          </div>

          <!-- Small Accent Decorative Star Beside Frame -->
          <div class="absolute -bottom-4 -left-4 sm:-bottom-6 sm:-left-6 w-10 h-10 rounded-full bg-brand-surface border border-brand-border flex items-center justify-center shadow-md">
            <Icon name="sparkle" class="w-5 h-5 text-brand-accent" />
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
