---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';

const allProjects = await getCollection('projects');
// Ambil proyek featured atau maksimal 3 proyek terbaru
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<section id="proyek" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="projects-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section (Sesuai Gaya SELECTED PROJECTS pada Gambar Referensi) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 pb-4 border-b border-brand-border">
      <div>
        <span class="text-xs font-sans tracking-[0.2em] uppercase font-semibold text-brand-muted block mb-1">
          Karya & Eksplorasi
        </span>
        <div class="flex items-center gap-2">
          <h2 id="projects-heading" class="font-serif text-3xl sm:text-5xl font-medium tracking-tight text-brand-primary uppercase">
            Proyek Unggulan
          </h2>
          <Icon name="star" class="w-4 h-4 text-brand-accent mb-1" />
        </div>
      </div>

      <a
        href="/projects"
        class="group inline-flex items-center gap-2 text-xs font-sans tracking-[0.18em] font-semibold uppercase text-brand-primary hover:text-brand-accent transition-colors mt-4 sm:mt-0"
      >
        <span>Lihat Semua Proyek</span>
        <span class="transform group-hover:translate-x-1 transition-transform">
          <Icon name="arrow-right" class="w-4 h-4" />
        </span>
      </a>
    </div>

    <!-- Grid 3 Kartu Proyek -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- Tombol Mobile Tambahan -->
    <div class="mt-10 text-center sm:hidden">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-brand-primary text-xs font-semibold tracking-wider uppercase text-brand-primary hover:bg-brand-primary hover:text-brand-bg transition-colors"
      >
        <span>Lihat Semua Proyek ({allProjects.length})</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>
