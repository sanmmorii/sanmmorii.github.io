---
import { siteConfig } from '../data/site';
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const { personal } = siteConfig;
---

<footer class="w-full bg-brand-surface border-t border-brand-border pt-16 pb-12 text-brand-text">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Bagian Atas Footer (Mirip Desain Referensi) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-brand-border/80 items-center">
      
      <!-- Logo Monogram & Slogan Singkat (md:col-span-5) -->
      <div class="md:col-span-5 flex items-center gap-4">
        <a href="/" class="group block" aria-label="Kembali ke atas">
          <span class="font-serif text-5xl font-medium tracking-tight text-brand-primary group-hover:text-brand-accent transition-colors">
            {personal.shortName.charAt(0)}
          </span>
        </a>
        <div class="border-l border-brand-border pl-4">
          <p class="font-sans text-xs tracking-[0.16em] uppercase font-bold text-brand-primary">
            {personal.name}
          </p>
          <p class="font-sans text-[11px] tracking-wider text-brand-muted mt-0.5">
            Membangun Pengalaman Digital Bermakna Melalui Kode & Desain
          </p>
        </div>
      </div>

      <!-- Info Surel & Lokasi (md:col-span-4) -->
      <div class="md:col-span-4 space-y-2">
        <div class="flex items-center gap-2.5 text-xs text-brand-text/90">
          <Icon name="mail" class="w-4 h-4 text-brand-accent" />
          <a href={`mailto:${personal.email}`} class="hover:text-brand-accent transition-colors">
            {personal.email}
          </a>
        </div>
        <div class="flex items-center gap-2.5 text-xs text-brand-text/90">
          <Icon name="map-pin" class="w-4 h-4 text-brand-accent" />
          <span>{personal.location}</span>
        </div>
      </div>

      <!-- Ikon Sosial Media (md:col-span-3) -->
      <div class="md:col-span-3 flex md:justify-end items-center gap-3">
        {personal.social.linkedin && (
          <a
            href={personal.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-brand-border bg-brand-bg/80 flex items-center justify-center text-brand-primary hover:bg-brand-primary hover:text-brand-bg hover:border-brand-primary transition-all duration-300 shadow-sm"
            aria-label="Profil LinkedIn"
          >
            <Icon name="linkedin" class="w-4 h-4" />
          </a>
        )}

        {personal.social.github && (
          <a
            href={personal.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-brand-border bg-brand-bg/80 flex items-center justify-center text-brand-primary hover:bg-brand-primary hover:text-brand-bg hover:border-brand-primary transition-all duration-300 shadow-sm"
            aria-label="Profil GitHub"
          >
            <Icon name="github" class="w-4 h-4" />
          </a>
        )}

        {personal.social.instagram && (
          <a
            href={personal.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-brand-border bg-brand-bg/80 flex items-center justify-center text-brand-primary hover:bg-brand-primary hover:text-brand-bg hover:border-brand-primary transition-all duration-300 shadow-sm"
            aria-label="Profil Instagram"
          >
            <Icon name="instagram" class="w-4 h-4" />
          </a>
        )}
      </div>

    </div>

    <!-- Bagian Bawah Footer (Hak Cipta & Navigasi Cepat) -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-brand-muted gap-4">
      <p class="font-sans tracking-wider uppercase text-[11px]">
        © {currentYear} {personal.name}. Seluruh Hak Cipta Dilindungi.
      </p>

      <div class="flex items-center gap-6 text-[11px] font-sans tracking-widest uppercase font-semibold">
        <a href="/#proyek" class="hover:text-brand-primary transition-colors">Proyek</a>
        <a href="/#tentang" class="hover:text-brand-primary transition-colors">Tentang</a>
        <a href="/kegiatan" class="hover:text-brand-primary transition-colors">Galeri Kegiatan</a>
        <a href="/#kontak" class="hover:text-brand-primary transition-colors">Kontak</a>
      </div>
    </div>

  </div>
</footer>
